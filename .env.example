# AlertCheck Environment Configuration Example
# Copy to .env or .env.local as needed

# Frontend Configuration
# Optional: Set backend worker API base URL. If empty or unreachable, frontend automatically uses in-browser fallback.
VITE_API_BASE_URL=http://localhost:8787

# Backend Cloudflare Worker Configuration (Optional local dev settings)
PORT=8787
FRONTEND_ORIGIN=http://localhost:5173
