# AlertCheck local development reference values.
# This file is documentation only; Vite and Wrangler load their own environment files.

# Frontend build-time URL. Public value only; never put secrets in VITE_* variables.
VITE_API_BASE_URL=http://localhost:8787

# Worker CORS origin. The active local value is also set in backend/wrangler.jsonc.
# For production, set this to the exact deployed Pages origin.
ALLOWED_ORIGIN=http://localhost:5173
